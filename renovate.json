{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>delta592/renovate-config:default.json"
  ],
  "enabledManagers": [
    "github-actions",
    "homebrew",
    "regex",
    "swift"
  ],
  "packageRules": [
    {
      "description": "Group CI action updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group Homebrew formula updates",
      "matchManagers": ["homebrew"],
      "groupName": "Homebrew formulae"
    }
  ]
}
